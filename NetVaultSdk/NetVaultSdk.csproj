<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="9.0.10" />
    </ItemGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Thales Belinazzi</Authors>
        <Description>Library to integrate with NetVault Secret Manager.</Description>
        <PackageTags>ASP.NET;ASP.NET Core;Dependency Injection;C#;.NET;NET6;NET7;NET8;Security;SDK;NetVault</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/NetVault-Org/NetVault-SDK</PackageProjectUrl>
        <RepositoryUrl>https://github.com/NetVault-Org/NetVault-SDK</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="icon.png">
            <Pack>true</Pack>
            <PackagePath>icon.png</PackagePath>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Resource>
    </ItemGroup>

    <ItemGroup>
        <None Remove="../README.md" />
        <Resource Include="../README.md">
            <Pack>true</Pack>
            <PackagePath>README.md</PackagePath>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Resource>
    </ItemGroup>

</Project>
